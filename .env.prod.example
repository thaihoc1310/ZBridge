# ── Production (.env.prod) ────────────────────────────────────────────────────
# Copy to .env.prod on the VPS, fill in every value, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Keep this file at mode 600 — it holds every secret the stack needs.

# ── Images ───────────────────────────────────────────────────────────────────
REGISTRY=ghcr.io
# GitHub user or org that owns the packages, lowercase.
IMAGE_OWNER=your-github-user
# Pin to a released tag rather than `latest` so a redeploy is reproducible.
IMAGE_TAG=latest

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=zbridge
POSTGRES_USER=zbridge
POSTGRES_PASSWORD=
# Must match the three values above.
DATABASE_URL=postgresql+asyncpg://zbridge:CHANGE_ME@postgres:5432/zbridge
REDIS_URL=redis://redis:6379/0

# ── Public address ───────────────────────────────────────────────────────────
# The hostname served by the Cloudflare tunnel.
APP_URL=https://zbridge.example.com
# Cookies must be Secure because the browser talks HTTPS to Cloudflare.
COOKIE_SECURE=true
# Used for the links inside Telegram alerts; same as APP_URL in most setups.
ALERT_LINK_BASE_URL=https://zbridge.example.com

# ── Secrets (generate fresh, never reuse the dev values) ─────────────────────
#   openssl rand -hex 32      -> JWT_SECRET
#   openssl rand -base64 32   -> the others
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
ZALO_GATEWAY_SECRET=
ZALO_EVENT_SECRET=
# Changing this makes the saved Zalo session unreadable and forces a QR re-scan.
ZALO_SESSION_SECRET=

# ── First admin ──────────────────────────────────────────────────────────────
# Only used to create the account on an empty database.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Zero Trust > Networks > Tunnels > create tunnel > copy the token.
# Route the public hostname to http://frontend:8080
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=latest

# ── Alerting ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_SEVERITY=WARNING
ALERT_DEDUP_WINDOW_SECONDS=900
LOGIN_FAILURE_ALERT_THRESHOLD=5
LOGIN_FAILURE_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=20

# ── Backup ───────────────────────────────────────────────────────────────────
# Mã hoá backup trước khi đẩy ra ngoài (dump chứa dữ liệu khách hàng và hash mật
# khẩu; gói session chứa credential Zalo). Passphrase phải lưu ở NƠI KHÁC — mất
# nó là mất luôn khả năng phục hồi.
BACKUP_PASSPHRASE=
# Đích rclone, để trống thì chỉ giữ bản local. Ví dụ Cloudflare R2:
#   BACKUP_REMOTE=r2:zbridge-backups/prod
BACKUP_REMOTE=
RETENTION_DAYS=14
# rclone đọc thẳng các biến này, không cần chạy `rclone config`.
# R2: Cloudflare dashboard > R2 > Manage API tokens (chỉ cấp quyền 1 bucket).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACL=private

# ── Tuning ───────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
CELERY_CONCURRENCY=4
AI_CONCURRENCY=4
ALERT_CONCURRENCY=2
MENTION_SCHEDULER_INTERVAL_SECONDS=15
MENTION_CLASSIFIER_INTERVAL_SECONDS=5
# Mention classifier LLM. Default is FPT Cloud / DeepSeek-V4-Flash; set
# LLM_PROVIDER=openai with LLM_MODEL=gpt-5.4-nano-2026-03-17 and
# LLM_SKIP_CONFIDENCE=0.85 to fall back to OpenAI.
LLM_PROVIDER=fptcloud
LLM_BASE_URL=https://mkp-api.fptcloud.com
LLM_MODEL=DeepSeek-V4-Flash
LLM_TIMEOUT_SECONDS=30
LLM_SKIP_CONFIDENCE=0.75
# Nguong de TAG khi khach hoi gia (nhanh nay fail-closed).
LLM_PRICE_CONFIDENCE=0.65
FPTAI_API_KEY=
OPENAI_API_KEY=
DEBT_REMINDER_SCHEDULER_INTERVAL_SECONDS=60
ZALO_SEND_INTERVAL_MS=1000
# Memory ceilings; raise WORKER_MEM_LIMIT if Sheet-to-PNG rendering gets killed.
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
BACKEND_MEM_LIMIT=512m
WORKER_MEM_LIMIT=1g
ALERTS_MEM_LIMIT=256m
BEAT_MEM_LIMIT=256m
GATEWAY_MEM_LIMIT=512m
FRONTEND_MEM_LIMIT=128m
CLOUDFLARED_MEM_LIMIT=128m
