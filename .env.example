POSTGRES_DB=zbridge
POSTGRES_USER=zbridge
POSTGRES_PASSWORD=thaihoc285
DATABASE_URL=postgresql+asyncpg://zbridge:thaihoc285@postgres:5432/zbridge
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=480
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=12345678
ZALO_GATEWAY_URL=http://zalo-gateway:3001
ZALO_GATEWAY_SECRET=replace-with-an-internal-shared-secret
ZALO_EVENT_SECRET=replace-with-a-second-internal-shared-secret
ZALO_SESSION_PATH=/data/zalo-session/session.enc
ZALO_SESSION_SECRET=replace-with-another-long-random-secret
APP_URL=http://localhost:5173
VITE_API_URL=/api
ZALO_MOCK=false
MENTION_SCHEDULER_INTERVAL_SECONDS=15
MENTION_CLASSIFIER_INTERVAL_SECONDS=5
CELERY_CONCURRENCY=4
AI_CONCURRENCY=4
# Mention classifier LLM. Default is FPT Cloud / DeepSeek-V4-Flash; set
# LLM_PROVIDER=openai with LLM_MODEL=gpt-5.4-nano-2026-03-17 and
# LLM_SKIP_CONFIDENCE=0.85 to fall back to OpenAI.
LLM_PROVIDER=fptcloud
LLM_BASE_URL=https://mkp-api.fptcloud.com
LLM_MODEL=DeepSeek-V4-Flash
LLM_TIMEOUT_SECONDS=30
LLM_SKIP_CONFIDENCE=0.75
FPTAI_API_KEY=
OPENAI_API_KEY=
DEBT_REMINDER_SCHEDULER_INTERVAL_SECONDS=60
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
ZALO_SEND_INTERVAL_MS=1000

# Cảnh báo lỗi qua Telegram. Tạo bot bằng @BotFather, thêm bot vào group rồi
# lấy group id (số âm). Chỉ container celery-alerts cần token này.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WARNING gồm cả lỗi tạm thời; đặt ERROR nếu chỉ muốn lỗi nghiêm trọng.
ALERT_MIN_SEVERITY=WARNING
ALERT_DEDUP_WINDOW_SECONDS=900
ALERT_CONCURRENCY=2
LOGIN_FAILURE_ALERT_THRESHOLD=5
# Link trong tin cảnh báo. Telegram KHÔNG tạo link tới localhost, nên nếu muốn
# bấm được thì đặt IP LAN hoặc domain thật, ví dụ http://192.168.1.50:5173
# Để trống thì dùng APP_URL.
ALERT_LINK_BASE_URL=
